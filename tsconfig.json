{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "background-agent-service": ["./modules/background-agent-service/index.ts"],
      "scheduler-alarm": ["./modules/scheduler-alarm/index.ts"],
      "process-text": ["./modules/process-text/index.ts"],
      "device-automation": ["./modules/device-automation/index.ts"],
      "saf-file-operations": ["./modules/saf-file-operations/index.ts"],
      "accessibility-agent": ["./modules/accessibility-agent/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
